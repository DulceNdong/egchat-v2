<?xml version="1.0" encoding="utf-8"?>
<!--
  splash.xml — Splash Screen nativa EGCHAT (modo oscuro)
  Fondo oscuro #0f172a con el logo en verde EGCHAT.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fondo oscuro para modo noche -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0f172a" />
        </shape>
    </item>

    <!-- Logo centrado — círculo verde EGCHAT -->
    <item
        android:gravity="center"
        android:width="160dp"
        android:height="160dp">
        <shape android:shape="oval">
            <solid android:color="#00c8a0" />
            <size android:width="160dp" android:height="160dp" />
        </shape>
    </item>

</layer-list>
