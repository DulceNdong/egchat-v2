<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_launcher.xml (drawable-v26) — Icono adaptativo para Android 8+ (API 26)
  Esta carpeta tiene prioridad sobre mipmap-anydpi-v26 en algunos launchers.
  Usa el mismo foreground vectorial con padding 33% y fondo verde EGCHAT.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
