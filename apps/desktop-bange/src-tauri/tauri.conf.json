{
  "productName": "BANGE KYC Admin",
  "version": "1.0.0",
  "identifier": "com.egchat.bange.kyc",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../dashboard-bange/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BANGE — Panel de Cumplimiento KYC",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://egchat-api-xlxj.onrender.com; connect-src 'self' https://egchat-api-xlxj.onrender.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "TAURI_UPDATER_PUBLIC_KEY_PLACEHOLDER_REPLACE_IN_PRODUCTION",
      "endpoints": [
        "https://egchat-api-xlxj.onrender.com/updates/bange/{{target}}/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
