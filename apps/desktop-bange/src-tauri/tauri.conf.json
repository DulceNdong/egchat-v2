{
  "productName": "BANGE KYC Admin",
  "version": "1.0.0",
  "identifier": "com.egchat.bange.kyc",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../dashboard-bange/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BANGE — Panel de Cumplimiento KYC",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://egchat-api-xlxj.onrender.com; connect-src 'self' https://egchat-api-xlxj.onrender.com wss://egchat-api-xlxj.onrender.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "entitlements": null,
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://egchat-api-xlxj.onrender.com/updates/bange/{{target}}/{{arch}}/latest.json"
      ],
      "dialog": true,
      "pubkey": "TAURI_PUBLIC_KEY_PLACEHOLDER"
    }
  }
}
