{
  "productName": "EGCHAT KYC Monitor",
  "version": "1.0.0",
  "identifier": "com.egchat.empresa.kyc",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../dashboard-empresa/dist"
  },
  "app": {
    "windows": [
      {
        "title": "EGCHAT — Monitor KYC",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https://egchat-api-xlxj.onrender.com; connect-src 'self' https://egchat-api-xlxj.onrender.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
