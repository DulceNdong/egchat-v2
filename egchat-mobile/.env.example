# ══════════════════════════════════════════════════════════════════
# EGChat — Variables de entorno requeridas
# Copia este archivo a .env.local y rellena los valores reales.
# NUNCA subas .env.local a git.
# ══════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://fqfxtjnfhvpggssbymdn.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key del proyecto Supabase>

# SERVICE ROLE — solo para el backend Render y scripts. NUNCA en el cliente.
# Obtener en: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# ── Backend Render ────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=https://egchat-api-xlxj.onrender.com

# JWT secret del backend Render (mismo que usa index.js para firmar tokens)
# Obtener en: Render Dashboard → egchat-api → Environment → JWT_SECRET
JWT_SECRET=<jwt secret del backend Render>

# Secreto compartido entre Render y Supabase Edge Functions
# Generar con: openssl rand -hex 32
SERVICE_TOKEN=<generar con: openssl rand -hex 32>

# ── APNs VoIP (iOS CallKit) ───────────────────────────────────────
# Obtener en: Apple Developer → Certificates → Keys → AuthKey_XXXXXXXX.p8
# Contenido del archivo .p8 SIN las líneas -----BEGIN/END PRIVATE KEY-----
APNS_KEY_P8=<contenido del AuthKey_XXXXXXXX.p8 sin headers>
# Key ID: los 10 caracteres del nombre del archivo (AuthKey_XXXXXXXXXX.p8)
APNS_KEY_ID=<10 chars, ej: ABC1234567>
# Team ID: en Apple Developer → Account → Membership → Team ID
APNS_TEAM_ID=XU6YD7ZJ2K
# Bundle ID de la app
APNS_BUNDLE_ID=com.jallzstores.egchat
# "production" para App Store/TestFlight, "sandbox" para desarrollo
APNS_ENV=production

# ── Firebase FCM (Android) ────────────────────────────────────────
# Obtener en: Firebase Console → Project Settings → Service Accounts
# → Generate new private key → descargar JSON
# Pegar el CONTENIDO COMPLETO del JSON aquí (en una sola línea)
FCM_SERVICE_ACCOUNT_JSON=<JSON completo del service account>
# Project ID de Firebase
FCM_PROJECT_ID=egchat-4efe7

# ── TURN Servers (WebRTC) ─────────────────────────────────────────
# Opcional: si no se configura, usa OpenRelay gratuito (sin SLA)
# Obtener en: Twilio Console → Elastic SIP Trunking → TURN
TWILIO_ACCOUNT_SID=<twilio account sid>
TWILIO_API_KEY_SID=<twilio api key sid>
TWILIO_API_KEY_SECRET=<twilio api key secret>

# ── Expo Push (fallback) ──────────────────────────────────────────
# Opcional: mejora rate limits de Expo Push
# Obtener en: https://expo.dev/accounts/reddington120/settings/access-tokens
EXPO_ACCESS_TOKEN=<expo access token opcional>

# ── Firebase App (cliente móvil) ──────────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyB1VKzNGKOOI99QR9r_RIU1qRIo_f_H0Zw
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=egchat-4efe7.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://egchat-4efe7-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=egchat-4efe7
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=egchat-4efe7.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=745900172350
EXPO_PUBLIC_FIREBASE_APP_ID=1:745900172350:android:758256b45294a7db695d6f

# ── Flags de funcionalidades ──────────────────────────────────────
EXPO_PUBLIC_ENABLE_PUSH=1
EXPO_PUBLIC_ENABLE_VOIP=1
EXPO_PUBLIC_ENABLE_WEBRTC=1
