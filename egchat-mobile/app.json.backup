{
  "expo": {
    "name": "EGCHAT",
    // ... el resto de tu configuración ...
    "jsEngine": "hermes",
    "experiments": {
      "tsconfigPaths": true
    }
  }
}  "expo": {
    "name": "EGCHAT",
    "slug": "egchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.egchat.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "EGCHAT necesita la cámara para fotos, videollamadas y escanear QR.",
        "NSPhotoLibraryUsageDescription": "EGCHAT necesita acceso a tus fotos y videos para enviarlos en el chat.",
        "NSPhotoLibraryAddUsageDescription": "EGCHAT puede guardar archivos recibidos si lo solicitas.",
        "NSLocationWhenInUseUsageDescription": "EGCHAT necesita tu ubicación para compartirla en el chat.",
        "NSContactsUsageDescription": "EGCHAT necesita acceso a tus contactos para compartirlos en el chat.",
        "NSMicrophoneUsageDescription": "EGCHAT necesita el micrófono para llamadas de voz y video.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.egchat.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_EXTERNAL_STORAGE",
        "READ_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-document-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "EGCHAT necesita la cámara para fotos, videollamadas y escanear QR.",
          "microphonePermission": "EGCHAT necesita el micrófono para llamadas de voz y video.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "EGCHAT necesita tu ubicacion para servicios de taxi."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00c8a0",
          "defaultChannel": "egchat-messages",
          "sounds": [
            "./assets/notification.wav"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "egchat",
    "extra": {
      "apiUrl": "https://egchat-api.onrender.com",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6200ec00-54d7-4ef4-a348-56e80a1452f6"
      }
    },
    "runtimeVersion": "1.0.0",
    "owner": "reddington120"
  }
}
