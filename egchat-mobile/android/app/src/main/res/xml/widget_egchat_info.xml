<?xml version="1.0" encoding="utf-8"?>
<!--
  Metadatos del widget de EGChat para la pantalla de inicio.
  minWidth/minHeight definen el tamaño mínimo en celdas del launcher.
  2 celdas de ancho × 2 de alto ≈ 110dp × 110dp
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_egchat"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/app_name"/>
