<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout del widget de EGChat.
  Muestra los 3 chats más recientes/con más no leídos + badge de total no leídos.
  Fondo redondeado con el color principal de la marca (#00C8A0 verde EGChat).
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#1A1A2E"
    android:gravity="center_horizontal">

    <!-- Header: logo / título + badge total no leídos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EGCHAT"
            android:textColor="#00C8A0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"/>

        <!-- Badge total no leídos -->
        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="#00C8A0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Chat 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/chat_msg_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/chat_unread_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="#00C8A0"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:gravity="center"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A3E"/>

    <!-- Chat 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/chat_msg_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/chat_unread_2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="#00C8A0"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:gravity="center"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A3E"/>

    <!-- Chat 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_name_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/chat_msg_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/chat_unread_3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="#00C8A0"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:gravity="center"
            android:visibility="gone"/>
    </LinearLayout>

</LinearLayout>
