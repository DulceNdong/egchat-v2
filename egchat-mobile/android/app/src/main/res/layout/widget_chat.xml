<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header: título + botón nuevo chat -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="EGChat"
            android:textColor="#111827"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/widget_new_chat_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_btn_bg"/>
    </LinearLayout>

    <!-- Fila chat 1 -->
    <LinearLayout android:id="@+id/widget_row_1"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <ImageView android:id="@+id/widget_avatar_1"
            android:layout_width="40dp" android:layout_height="40dp"
            android:scaleType="centerCrop"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView android:id="@+id/widget_name_1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#111827" android:textSize="13sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_msg_1"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#6b7280" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_badge_1"
            android:layout_width="20dp" android:layout_height="20dp"
            android:gravity="center" android:textColor="#FFFFFF"
            android:textSize="10sp" android:textStyle="bold"
            android:background="@drawable/widget_badge_bg"/>
    </LinearLayout>

    <!-- Fila chat 2 -->
    <LinearLayout android:id="@+id/widget_row_2"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="4dp">
        <ImageView android:id="@+id/widget_avatar_2"
            android:layout_width="40dp" android:layout_height="40dp"
            android:scaleType="centerCrop"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView android:id="@+id/widget_name_2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#111827" android:textSize="13sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_msg_2"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#6b7280" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_badge_2"
            android:layout_width="20dp" android:layout_height="20dp"
            android:gravity="center" android:textColor="#FFFFFF"
            android:textSize="10sp" android:textStyle="bold"
            android:background="@drawable/widget_badge_bg"/>
    </LinearLayout>

    <!-- Fila chat 3 -->
    <LinearLayout android:id="@+id/widget_row_3"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_avatar_3"
            android:layout_width="40dp" android:layout_height="40dp"
            android:scaleType="centerCrop"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView android:id="@+id/widget_name_3"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#111827" android:textSize="13sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_msg_3"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#6b7280" android:textSize="11sp"
                android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_badge_3"
            android:layout_width="20dp" android:layout_height="20dp"
            android:gravity="center" android:textColor="#FFFFFF"
            android:textSize="10sp" android:textStyle="bold"
            android:background="@drawable/widget_badge_bg"/>
    </LinearLayout>

</LinearLayout>
